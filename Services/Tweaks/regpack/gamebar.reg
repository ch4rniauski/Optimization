Windows Registry Editor Version 5.00
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\GameDVR]
"AppCaptureEnabled"=dword:0
[HKEY_CURRENT_USER\System\GameConfigStore]
"GameDVR_Enabled"=dword:0

[HKEY_CLASSES_ROOT\ms-gamebar]
@="URL:ms-gamebar"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\ms-gamebar\shell]

[HKEY_CLASSES_ROOT\ms-gamebar\shell\open]

[HKEY_CLASSES_ROOT\ms-gamebar\shell\open\command]
@="\"C:\\Windows\\System32\\systray.exe\""

[HKEY_CLASSES_ROOT\ms-gamebarservices]
@="URL:ms-gamebarservices"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\ms-gamebarservices\shell]

[HKEY_CLASSES_ROOT\ms-gamebarservices\shell\open]

[HKEY_CLASSES_ROOT\ms-gamebarservices\shell\open\command]
@="\"C:\\Windows\\System32\\systray.exe\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PolicyManager\default\ApplicationManagement\AllowGameDVR]
"value"=dword:00000000
