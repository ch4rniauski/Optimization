<!--updates-->
                <Border BorderBrush="DimGray" BorderThickness="0 0 0 1" Height="auto">
                    <StackPanel Margin="0 2.5 0 2.5">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Height="30">
                            <TextBlock Text="Не работают обновления Windows"
                                       FontWeight="Medium" FontFamily="/Fonts/#Gilroy" FontSize="18" Width="495"
                                       VerticalAlignment="Center" Foreground="#A9A9A9" Margin="5 0 0 0"/>
                            <TextBlock FontSize="15" FontWeight="Medium" FontFamily="/Fonts/#Gilroy" Margin="10 0 10 0" 
                                       VerticalAlignment="Center" Foreground="#00CAEC" Width="270"
                                       TextAlignment="Right" x:Name="updates5" Opacity="0"
                                       Text="Исправлено! Требуется перезагрузка."/>
                            <Button x:Name="updates" 
                                    Content="Исправить" SnapsToDevicePixels="True"
                                    Height="24"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Width="115"
                                    Foreground="White"
                                    FontFamily="/Fonts/#Gilroy"
                                    FontWeight="SemiBold"
                                    FontSize="14" Margin="0 0 10 0"
                                    BorderThickness="3"
                                    BorderBrush="White"
                                    IsEnabled="True">
                                <Button.Effect>
                                    <DropShadowEffect ShadowDepth="0" Color="#bababa"
                                          x:Name="updates1"
                                          BlurRadius="0" Opacity="0"/>
                                </Button.Effect>
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="#1D1C1D"/>
                                        <Setter Property="Template">

                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#7a7a7a"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#E8E8E8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Resources>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Button.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                        Storyboard.TargetName="updates1"
                                        Storyboard.TargetProperty="BlurRadius"
                                        From="0" To="20" Duration="0:0:0.1"/>
                                                <DoubleAnimation
                                        Storyboard.TargetName="updates1"
                                        Storyboard.TargetProperty="BlurRadius"
                                        From="20" To="15" 
                                        BeginTime="0:0:0.1" Duration="0:0:0.25"/>
                                                <DoubleAnimation
                                        Storyboard.TargetName="updates1"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0" To="1" Duration="0:0:0.0005"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Button.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation 
                                          Storyboard.TargetName="updates1"
                                          Storyboard.TargetProperty="BlurRadius"
                                          From="15" To="0" Duration="0:0:0.3"/>
                                                <DoubleAnimation 
                                          Storyboard.TargetName="updates1"
                                          Storyboard.TargetProperty="Opacity"
                                          From="1" To="0" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>